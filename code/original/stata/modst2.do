/* Using "collapse" to aggregate to the State LEVEL using the following command *//* collapse (mean) r_sex  vmttot pi gasprice lnmnonl tolnmile tloclnm vmttotpc lnmnonpc lma lmi lmc vmti vmta vmtc vmtipc vmtapc vmtcpc vmttotnl vmtnlpc  lnmnl90 tolnml90 pi90 gas90 vmttot90 lmi90 lma90 lmc90 vmti90 vmta90 vmtc90  vmttnl90 pop90 pop95, by (stateid) */use ":Macintosh HD:Desktop Folder:paper:modst2.dta"gen lm95= lma+lmi+lmcgen lm90= lma90+lmi90+lmc90gen abslm= (lm95-lm90)/lm90gen absvmt= (vmttot-vmttot90)/vmttot90gen absinc= (pi-pi90)/pi90gen abspop=(pop95-pop90)/pop90gen absgas= (gasprice-gas90)/gas90gen nettt= (tt95-tt90)gen netact1= (act1-act190)gen netact2= (act2-act290)gen netact3= (act3-act390)gen netact4= (act4-act490)sureg (nettt abslm abspop absinc absgas)(netact1 abslm abspop absinc absgas) (netact2 abslm abspop absinc absgas)(netact3 abslm abspop absinc absgas)regress netact4 abslm abspop absinc absgas